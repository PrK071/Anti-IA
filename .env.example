# Cadastre os valores reais somente no painel da Vercel ou em um .env local ignorado.
DEEPSEEK_API_KEY=

# Opcional. Valores aceitos: deepseek-flash (padrão) ou deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

# Verificação: auto usa GPTZero se a chave existir, ou DeepSeek.
AI_DETECTOR_PROVIDER=auto

# Opcional. A mesma DEEPSEEK_API_KEY da humanização ativa a análise por DeepSeek.
DEEPSEEK_DETECTOR_MODEL=deepseek-flash

# Opcional. Use a chave da API oficial, não o login do site GPTZero.
GPTZERO_API_KEY=
